{
  "manifest_version": 3,
  "name": "Dadblock - AI Scam Guard & Ad Blocker",
  "version": "1.1.0",
  "description": "Your browser's protective dad: AI scam checks, ad and pop-up blocking, and a plain-English report on what each page is up to.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "alarms",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "world": "ISOLATED",
      "all_frames": false,
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.googlevideo.com/*",
        "*://*.ytimg.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "report-collector.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false,
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.googlevideo.com/*",
        "*://*.ytimg.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-dad-neutral-16.png",
      "32": "icons/icon-dad-neutral-32.png",
      "48": "icons/icon-dad-neutral-48.png",
      "128": "icons/icon-dad-neutral-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-dad-neutral-16.png",
    "32": "icons/icon-dad-neutral-32.png",
    "48": "icons/icon-dad-neutral-48.png",
    "128": "icons/icon-dad-neutral-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
